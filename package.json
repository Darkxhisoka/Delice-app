{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "capgo:bundle": "vite build && npx @capgo/cli bundle zip --path dist",
    "capgo:upload": "vite build && npx @capgo/cli upload --path dist",
    "capgo:deploy": "vite build && npx @capgo/cli upload --channel production --path dist",
    "capgo:deploy:beta": "vite build && npx @capgo/cli upload --channel beta --path dist",
    "electron:start": "vite build && npx cap copy @capacitor-community/electron && cd electron && npm install && npm run electron:start",
    "electron:build": "vite build && npx cap copy @capacitor-community/electron && cd electron && npm install && npm run build",
    "electron:pack": "vite build && npx cap copy @capacitor-community/electron && cd electron && npm install && npm run electron:pack",
    "electron:make": "vite build && npx cap copy @capacitor-community/electron && cd electron && npm install && npm run electron:make"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capgo/capacitor-updater": "^8.51.13",
    "@google/genai": "^2.4.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.4.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.3.0",
    "i18next": "^26.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.5.4",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.12",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capgo/cli": "^8.37.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
